{
  "name": "@mindmap/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared build/lint configuration for the MindMap monorepo.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./eslint": "./src/eslint/index.js",
    "./eslint/next": "./src/eslint/next.js",
    "./tsconfig/base": "./tsconfig.base.json",
    "./tsconfig/nextjs": "./tsconfig.nextjs.json",
    "./tsconfig/react-library": "./tsconfig.react-library.json",
    "./tsconfig/node-library": "./tsconfig.node-library.json",
    "./tailwind": "./src/tailwind/preset.css"
  },
  "files": ["src", "tsconfig.*.json"],
  "scripts": {
    "lint": "echo \"(config has no runtime)\" && exit 0",
    "typecheck": "echo \"(config has no runtime)\" && exit 0",
    "build": "echo \"(config has no runtime)\" && exit 0",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@eslint/js": "^9.16.0",
    "@next/eslint-plugin-next": "16.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  }
}
