{
  "name": "@mindmap/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, client, migrations, seeds.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate && tsc --noEmit",
    "generate": "prisma generate",
    "push": "prisma db push --skip-generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "clean": "rm -rf .turbo dist"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@mindmap/brain": "workspace:*",
    "@mindmap/config": "workspace:*",
    "@mindmap/shared": "workspace:*",
    "@mindmap/types": "workspace:*",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "eslint": "^9.16.0",
    "typescript-eslint": "^8.18.0",
    "eslint-plugin-import": "^2.31.0"
  }
}
