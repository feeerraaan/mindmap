{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && corepack prepare pnpm@11.13.1 --activate && pnpm install",
  "buildCommand": "pnpm turbo build --filter=@mindmap/web...",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "outputDirectory": "apps/web/.next"
}
