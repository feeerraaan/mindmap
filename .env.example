# ─── Database ─────────────────────────────────────────────
# Use Neon Postgres. Local dev may use:
#   postgresql://postgres:postgres@localhost:5432/mindmap
DATABASE_URL="postgresql://user:pass@localhost:5432/mindmap?schema=public"

# ─── Better Auth ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-prod-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3100"

# ─── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Resend (Magic Link) ─────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MindMap <hello@mindmap.app>"

# ─── Uploads storage ─────────────────────────────────────
# Production: private storage service on the VPS (scripts/storage-server.mjs).
# MINDMAP_STORAGE_URL is the public HTTPS URL of that service; the token is a
# shared secret between the web app and the service. Generate with:
#   openssl rand -hex 32
MINDMAP_STORAGE_URL=""
MINDMAP_STORAGE_TOKEN=""
# Alternative for Vercel-only deploys: Vercel Blob.
BLOB_READ_WRITE_TOKEN=""
# Dev / self-hosted: local disk. Also used by the storage service as its root.
MINDMAP_LOCAL_BLOB_DIR="/var/mindmap/blobs"

# ─── OpenCode ZEN (fallback provider) ───────────────────
# Zen: curated model catalog at https://opencode.ai/zen/v1.
# Same API key works for Zen and Go. Both endpoints accept the
# OpenAI-compatible chat completions schema.
OPENCODE_ZEN_BASE_URL="https://opencode.ai/zen/v1"
OPENCODE_ZEN_KEY=""
# Default model for the Zen fallback.
OPENCODE_ZEN_MODEL="deepseek-v4-flash"

# ─── OpenCode GO (primary provider) ─────────────────────
# Go: provider catalog at https://opencode.ai/zen/go/v1.
# Use the SAME key as Zen.
OPENCODE_GO_BASE_URL="https://opencode.ai/zen/go/v1"
OPENCODE_GO_KEY=""
# Default model for the primary path (deepseek-v4-flash from the Go catalog).
OPENCODE_GO_MODEL="deepseek-v4-flash"

# ─── Brain — daily per-user token budget (optional) ─────
# Default: 500k tokens/day. Over-budget returns a "Mind is resting" UX
# instead of erroring.
BRAIN_DAILY_BUDGET="500000"

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3100"
NEXT_PUBLIC_APP_NAME="MindMap"
