# ─── Database ─────────────────────────────────────────────
# Use Neon Postgres. Local dev may use:
#   postgresql://postgres:postgres@localhost:5432/mindmap
DATABASE_URL="postgresql://user:pass@localhost:5432/mindmap?schema=public"

# ─── Better Auth ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-prod-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3100"

# ─── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Resend (Magic Link) ─────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MindMap <hello@mindmap.app>"

# ─── Vercel Blob (Uploads) ────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── OpenCode ZEN (Free tier provider) ───────────────────
OPENCODE_ZEN_BASE_URL="https://opencode.ai/zen/v1"
OPENCODE_ZEN_KEY=""

# ─── OpenCode GO (Pro tier provider) ─────────────────────
OPENCODE_GO_BASE_URL="https://opencode.ai/go/v1"
OPENCODE_GO_KEY=""

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3100"
NEXT_PUBLIC_APP_NAME="MindMap"
