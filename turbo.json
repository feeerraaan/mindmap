{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "concurrency": "2",
  "globalDependencies": [".env", ".env.local", "tsconfig.base.json", ".env.example"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "RESEND_API_KEY",
    "VITE_BLOB_TOKEN",
    "OPENCODE_ZEN_BASE_URL",
    "OPENCODE_ZEN_KEY",
    "OPENCODE_GO_BASE_URL",
    "OPENCODE_GO_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!**/*.spec.ts"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**", "!.next/types/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "!dist/**", "!build/**", "!node_modules/**"],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "!dist/**", "!build/**", "!node_modules/**"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!**/*.spec.ts"],
      "outputs": []
    }
  }
}
