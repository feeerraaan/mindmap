{
  "extends": "@mindmap/config/tsconfig/nextjs",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "messages/**/*.json",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
